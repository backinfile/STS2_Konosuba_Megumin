; Godot 4.6 standalone animation workbench, not an STS2 integration.
config_version=5
[application]
config/name="Megumin · Explosion Animation Lab"
run/main_scene="res://scenes/preview.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.06, 1)
[audio]
driver/enable_input=false
